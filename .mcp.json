{
  "mcpServers": {
    "voice-mcp": {
      "type": "stdio",
      "description": "Voice-enabled MCP server with speak, listen, and action tools. Provides text-to-speech via ElevenLabs and speech-to-text via browser.",
      "version": "1.0.0",
      "command": "bun",
      "args": ["run", "src/index.tsx"],
      "env": {
        "ELEVENLABS_API_KEY": "${ELEVENLABS_API_KEY}",
        "MCP_HTTP_PORT": "53245",
        "ELEVEN_VOICE_ID": "tAblEwhJ8ycHNukBlZMA",
        "ELEVEN_MODEL_ID": "eleven_flash_v2_5",
        "NODE_ENV": "production"
      }
    }
  }
}
